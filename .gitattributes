# Git LFS —— 二进制 fixture（决策：2026-09-22）
# Binary fixtures are stored via Git LFS.
# 见 docs/testing.md「Fixture 管理」/ see docs/testing.md "Fixture management"

tests/fixtures/**/*.png  filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.exr  filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.bin  filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.zst  filter=lfs diff=lfs merge=lfs -text

# 结构化 fixture 保持普通文本，必须可 diff
# Structured fixtures stay as plain text so they remain diffable.
tests/fixtures/**/*.json  text
tests/fixtures/**/*.yaml  text

# 文本文件统一 LF
* text=auto eol=lf
*.png binary
*.jpg binary
