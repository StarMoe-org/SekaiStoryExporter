/target
**/*.rs.bk

# 资产：任何情况下都不入库（见 README 法律边界）
/assets/
/cache/
# 用户自行导出的游戏包体资源（ipa 解包目录，如 6.4.0/）
/[0-9]*.[0-9]*.[0-9]*/
/[0-9]*.[0-9]*.[0-9]*.zip

# 渲染产物
/out/
*.mp4
*.mov
*.wav
*.png
!docs/**/*.png
# LFS 管理的参考帧 / reference frames under LFS
!tests/fixtures/**/*.png

# 逆向中间产物（体积大且含游戏代码，只提交提炼后的 constants.yaml）
/dumps/
tools/dumper/out/

.DS_Store
